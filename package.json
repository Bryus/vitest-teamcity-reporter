{
  "name": "@bryus/vitest-teamcity-reporter",
  "version": "0.6.2",
  "description": "A TeamCity reporter for vitest.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryus/vitest-teamcity-reporter.git"
  },
  "keywords": [
    "vitest",
    "teamcity",
    "reporter"
  ],
  "files": [
    "lib/**/*"
  ],
  "main": "lib/app/index.js",
  "types": "lib/app/index.d.ts",
  "scripts": {
    "clean": "rimraf lib",
    "test": "vitest --run src/test/index.spec.ts",
    "build": "pnpm clean && tsc -p tsconfig.lib.json",
    "lint": "biome check --write",
    "lint:ci": "biome check --reporter=github"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/utils": "^4.1.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "4.x || 5.x || 6.x || 7.x",
    "vitest": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Eike Lurz<eike.lurz@tuta.io>",
  "license": "MIT"
}
